# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<projekt-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Nur serverseitig (Login, Link-Pruefung, Mails, Cron)
SUPABASE_SECRET_KEY=sb_secret_...
# Privater ES256-JWK als eine Zeile (npm run gen:signing-key),
# in Supabase unter JWT Keys importieren und aktiv rotieren
SUPABASE_JWT_PRIVATE_KEY={"kty":"EC","crv":"P-256","x":"...","y":"...","d":"...","kid":"...","alg":"ES256"}

# --- App ----------------------------------------------------------------------
APP_URL=http://localhost:3040
# je 32+ zufaellige Bytes, z. B.: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
SHARE_LINK_SECRET=
CRON_SECRET=

# --- Zitadel (OIDC, Authorization Code + PKCE) --------------------------------
ZITADEL_ISSUER=https://auth.example.com
ZITADEL_CLIENT_ID=
# leer lassen bei Auth-Methode "None" (PKCE)
ZITADEL_CLIENT_SECRET=

# --- Resend -------------------------------------------------------------------
RESEND_API_KEY=re_...
MAIL_FROM=ys-planner <planner@example.com>

# --- Nur fuer npm run test:rls (Postgres-Connection-String, Rolle postgres) ----
DATABASE_URL=
